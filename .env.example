# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# DB_PORT is the host port Postgres is published on (5433 avoids clashing
# with a locally installed Postgres). Inside docker compose the API
# overrides these to db:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=qaryati
DB_PASSWORD=change-me
DB_NAME=qaryati
DB_RUN_MIGRATIONS=true
DB_LOGGING=false

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=Qaryati/1.0 (contact: yahyajaara1411@gmail.com)
GEOCODING_TIMEOUT_MS=5000
GEOCODING_CACHE_TTL_MS=86400000
GEOCODING_CACHE_MAX_ENTRIES=1000

# Auth. JWT_ACCESS_SECRET is required in production (min 32 chars); generate
# one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Development and test fall back to a dev-only secret when it is not set.
# JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# Optional first admin, created on startup if no user has this email yet.
# Set both or neither. ADMIN_PASSWORD needs at least 12 characters.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
