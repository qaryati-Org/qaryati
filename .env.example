# Copy to .env and adjust. Never commit .env.
NODE_ENV=development
PORT=3000
LOG_LEVEL=log

# DB_PORT is the host port Postgres is published on (5433 avoids clashing
# with a locally installed Postgres). Inside docker compose the API
# overrides these to db:5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=qaryati
DB_PASSWORD=change-me
DB_NAME=qaryati
DB_RUN_MIGRATIONS=true
DB_LOGGING=false
